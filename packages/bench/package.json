{
  "name": "@context-continue/bench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:scenarios": "tsc -p tsconfig.build.json && node dist/gen/write.js",
    "bench": "pnpm -C ../core build && tsc -p tsconfig.build.json && node --no-warnings=ExperimentalWarning dist/cli.js"
  },
  "dependencies": {
    "@context-continue/core": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
